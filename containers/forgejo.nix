{ config, lib, pkgs, utils, ... }:

# Forgejo, the git forge, as git.<domain>. The web UI and the API go through
# the reverse proxy, for example:
#
#   git.__DOMAIN__:443 {
#       import site_tls
#       reverse_proxy forgejo:3000
#   }
#
# Git over SSH goes to Forgejo's built in SSH server, published on
# homelab.forgejo.sshAddress (the tailnet address by default) at
# homelab.forgejo.sshPort (2222 by default). Clone URLs read
# ssh://git@git.<domain>:2222/<owner>/<repo>.git.
#
# With homelab.forgejo.trustDeployCa, the SSH server also accepts user
# certificates signed by homelab.deployCaKeys, the CA the hosts trust for
# root (modules/deploy-ca.nix). A certificate signs in as the Forgejo user
# whose account lists one of its principals; each user may list only their
# own user name, once, under Settings, SSH / GPG keys, Manage SSH
# principals. A fleet run's certificate then carries the principals root and
# the owner's Forgejo user name, and one touch of the hardware key serves
# the hosts and Forgejo (docs/adr/0015-forgejo-trusts-the-deploy-ca.md).
#
# Data, the SQLite database, repositories and the generated app.ini live in
# /var/lib/forgejo. Registration is closed. With homelab.forgejo.admin.name
# and .email set, the forgejo-admin unit creates the first admin once Forgejo
# answers, if it has none, and prints its one-time password to the journal:
#
#   journalctl -u forgejo-admin
#
# Without them, create the first admin by hand after the first start:
#
#   podman exec forgejo forgejo admin user create --admin \
#     --username <name> --email <address> --random-password
#
# Forgejo Actions is enabled; runners are registered separately.
#
# With homelab.forgejo.proxyAuth.enable, the web UI signs in the tailnet
# user Caddy passes as Remote-User. Forgejo trusts that header from any
# client and has no setting to limit it to an address, so HTTP then listens
# only on a unix socket that the caddy container mounts, and the git site
# changes to:
#
#   git.__DOMAIN__:443 {
#       import site_tls
#       import forgejo_identity
#       reverse_proxy unix//run/forgejo-http/http.sock
#   }
#
# forgejo_identity, generated by the reverse proxy, maps the tailnet login
# to the Forgejo user in homelab.forgejo.proxyAuth.users. Users are not
# created on first sign in; create them as the admin.
#
# With homelab.forgejo.oidc.enable instead, the web UI signs in through an
# OpenID Connect provider, tsidp (docs/adr/0006-tsidp-for-oidc-sign-in.md)
# or Pocket ID (docs/adr/0018-pocket-id-is-the-oidc-provider.md), as
# homelab.forgejo.oidc.provider says, and the git site stays as at the top.
# The forgejo-oidc unit adds the provider as a sign in source, "tailscale"
# for tsidp and "pocket-id" for Pocket ID, and keeps it in step with the
# config; switching providers updates and renames the one source in place.
# It reads the client's id and secret from two files, owned by root, mode
# 0400:
#
#   /var/lib/secrets/forgejo-oidc-client-id
#   /var/lib/secrets/forgejo-oidc-client-secret
#
# Declare the client in homelab.pocketId.clients, with the redirect URI
# https://git.<domain>/user/oauth2/pocket-id/callback and forgejo-oidc.service
# among its units, and Pocket ID writes both files. With tsidp on the same
# host, declare it in homelab.tsidp.clients with the redirect URI
# https://git.<domain>/user/oauth2/tailscale/callback and tsidp writes them
# (docs/adr/0010-tsidp-clients-declared-in-nix.md). Otherwise register it at
# the provider and put its id and secret there.
#
# A new user's first sign in creates their account, named after the part of
# their tailnet login before the @ with tsidp, or after their Pocket ID
# username. If that name or their email is taken, Forgejo asks them to sign
# in to the existing account with its password to link the two; the
# provider's user id differs between providers, so after a switch every
# existing user links once (docs/adr/0019-forgejo-and-grafana-on-pocket-id.md).
# Turning the option off leaves the source in Forgejo; delete it as the
# admin.
#
# The secret key is a file provisioned out of band, never committed:
#
#   openssl rand -hex 32 > /var/lib/secrets/forgejo-secret-key
#   chown forgejo:forgejo /var/lib/secrets/forgejo-secret-key
#   chmod 0400 /var/lib/secrets/forgejo-secret-key
#
# Forgejo refuses to start while the file is empty, so it never comes up
# with the well known default key. It does not make a key of its own: with
# INSTALL_LOCK and no key, 17.0.1 writes INTERNAL_TOKEN and the oauth2
# JWT_SECRET into app.ini but leaves SECRET_KEY empty and uses the default
# compiled into it.

let
  domain = config.homelab.domain;
  cfg = config.homelab.forgejo;
  sshPort = toString cfg.sshPort;
  uid = config.users.users.forgejo.uid;
  gid = config.users.groups.forgejo.gid;
  admin = cfg.admin;
  proxyAuth = cfg.proxyAuth.enable;
  oidc = cfg.oidc;
  pocketId = config.homelab.pocketId;
  # The source's name per provider, in the callback URL the provider must
  # allow. The unit renames a source of another provider's name in place.
  oidcSources = {
    tsidp = "tailscale";
    pocket-id = "pocket-id";
  };
  oidcSource = oidcSources.${oidc.provider};
  oidcFormerSources = lib.attrValues (removeAttrs oidcSources [ oidc.provider ]);
  # The provider's unit that writes the client's files before forgejo-oidc.
  oidcProviderUnit = {
    tsidp = "tsidp.service";
    pocket-id = "pocket-id-clients.service";
  }.${oidc.provider};
  # The host directory for the HTTP socket with proxy authentication on,
  # mounted at the same path in the forgejo and caddy containers.
  httpSocketDir = "/run/forgejo-http";
  httpSocket = "${httpSocketDir}/http.sock";
  adminScript = pkgs.callPackage ./forgejo-admin.nix { };
  oidcScript = pkgs.callPackage ./forgejo-oidc.nix { };
in
{
  imports = [ ../modules/options.nix ];

  # Static uid so the container's user option has a value at eval time.
  # See "Static user ids" in the README for the allocation. A host that
  # already has a forgejo user keeps its uid (NixOS does not change it), so
  # such a host overrides these defaults with its existing uid and gid.
  users.users.forgejo = {
    isSystemUser = true;
    group = "forgejo";
    uid = lib.mkDefault 602;
  };
  users.groups.forgejo = {
    gid = lib.mkDefault 602;
  };

  assertions = [
    {
      assertion = cfg.sshAddress != null;
      message = "containers/forgejo.nix publishes SSH on homelab.forgejo.sshAddress (homelab.tailnetIp by default), which is unset.";
    }
    {
      assertion = (admin.name == null) == (admin.email == null);
      message = "containers/forgejo.nix needs both homelab.forgejo.admin.name and homelab.forgejo.admin.email, or neither.";
    }
    {
      assertion = !cfg.trustDeployCa || config.homelab.deployCaKeys != [ ];
      message = "homelab.forgejo.trustDeployCa is on, but homelab.deployCaKeys is empty; Forgejo would trust no CA.";
    }
    {
      # Forgejo reads SSH_TRUSTED_USER_CA_KEYS as a comma separated list.
      assertion = !cfg.trustDeployCa
        || !(builtins.any (lib.hasInfix ",") config.homelab.deployCaKeys);
      message = "homelab.forgejo.trustDeployCa: a key in homelab.deployCaKeys contains a comma, which Forgejo would split it at; drop it from the key's comment.";
    }
    {
      assertion = !(proxyAuth && oidc.enable);
      message = "homelab.forgejo.proxyAuth and homelab.forgejo.oidc are both enabled; Forgejo signs in with one or the other.";
    }
  ] ++ lib.optionals oidc.enable (
    if oidc.provider == "pocket-id" then [
      {
        assertion = pocketId.enable;
        message = "homelab.forgejo.oidc.provider is pocket-id, but homelab.pocketId is not enabled on this host.";
      }
      {
        assertion = oidc.issuer == pocketId.url;
        message = "homelab.forgejo.oidc.issuer is ${toString oidc.issuer}, but with Pocket ID it is ${pocketId.url}; leave it unset.";
      }
      {
        assertion = lib.any (c: c.idFile == oidc.clientIdFile && c.secretFile == oidc.clientSecretFile
          && lib.elem "forgejo-oidc.service" c.units) (lib.attrValues pocketId.clients);
        message = "homelab.forgejo.oidc.provider is pocket-id: declare Forgejo's client in homelab.pocketId.clients, with idFile ${oidc.clientIdFile}, secretFile ${oidc.clientSecretFile} and forgejo-oidc.service among its units (docs/pocket-id.md).";
      }
    ] else [
      {
        assertion = oidc.issuer != null;
        message = "homelab.forgejo.oidc.provider is tsidp, which needs homelab.forgejo.oidc.issuer.";
      }
    ]);

  # The f rule creates an empty file if none exists, so podman never makes a
  # directory at the mount's source; it does not touch an existing file.
  systemd.tmpfiles.rules = [
    "d /var/lib/forgejo 0750 forgejo forgejo -"
    "f /var/lib/secrets/forgejo-secret-key 0400 forgejo forgejo -"
  ] ++ lib.optional proxyAuth "d ${httpSocketDir} 0750 forgejo forgejo -";

  virtualisation.oci-containers.containers.forgejo = {
    image = "codeberg.org/forgejo/forgejo@sha256:39362ab93a94c0c9b8b330d2a877ddbb3f02fa8c0cba1b8d686d437b39f36a04"; # 17.0.2-rootless, :17-rootless as of 2026-11-18
    autoStart = true;
    user = "${toString uid}:${toString gid}";
    # docs/adr/0014-containers-run-unprivileged.md
    extraOptions = [
      "--security-opt=no-new-privileges"
      "--cap-drop=ALL"
    ];
    # Only SSH is published, and only on sshAddress; HTTP stays on the podman
    # network behind Caddy.
    ports = [ "${toString cfg.sshAddress}:${sshPort}:${sshPort}" ];
    volumes = [
      "/var/lib/forgejo:/var/lib/gitea"
      "/var/lib/secrets/forgejo-secret-key:/etc/forgejo/secret-key:ro"
    ] ++ lib.optional proxyAuth "${httpSocketDir}:${httpSocketDir}";
    environment = {
      # The image writes RUN_USER from USER into app.ini on the first start,
      # and Forgejo refuses to run as anyone else. podman names the
      # container's user after the host user with that uid, forgejo.
      USER = "forgejo";

      FORGEJO__database__DB_TYPE = "sqlite3";

      FORGEJO__server__DOMAIN = "git.${domain}";
      FORGEJO__server__ROOT_URL = "https://git.${domain}/";
      FORGEJO__server__HTTP_PORT = "3000";
      FORGEJO__server__SSH_DOMAIN = "git.${domain}";
      FORGEJO__server__SSH_PORT = sshPort;
      FORGEJO__server__SSH_LISTEN_PORT = sshPort;
      # Clone URLs use git@; the built in server accepts only this user.
      FORGEJO__server__BUILTIN_SSH_SERVER_USER = "git";

      FORGEJO__security__INSTALL_LOCK = "true";
      FORGEJO__security__SECRET_KEY_URI = "file:/etc/forgejo/secret-key";

      # Accounts are made by the admin only.
      FORGEJO__service__DISABLE_REGISTRATION = "true";

      FORGEJO__actions__ENABLED = "true";

      # The image writes these into app.ini, where they stay when a variable
      # goes away, so the off state is set explicitly too.
      FORGEJO__server__PROTOCOL = if proxyAuth then "http+unix" else "http";
      FORGEJO__server__HTTP_ADDR = if proxyAuth then httpSocket else "0.0.0.0";
      FORGEJO__service__ENABLE_REVERSE_PROXY_AUTHENTICATION = lib.boolToString proxyAuth;
      FORGEJO__oauth2_client__ENABLE_AUTO_REGISTRATION = lib.boolToString oidc.enable;
      # With trustDeployCa, the built in server accepts certificates signed
      # by the deploy CA, as the user that lists one of the certificate's
      # principals as an SSH principal; with username, a user may list only
      # their own name. Off, no CA is trusted and no principals can be
      # added, which is also Forgejo's default without CA keys.
      FORGEJO__server__SSH_TRUSTED_USER_CA_KEYS =
        if cfg.trustDeployCa then lib.concatStringsSep "," config.homelab.deployCaKeys else "";
      FORGEJO__server__SSH_AUTHORIZED_PRINCIPALS_ALLOW =
        if cfg.trustDeployCa then "username" else "off";
    } // lib.optionalAttrs proxyAuth {
      # The REST API keeps to tokens (ENABLE_REVERSE_PROXY_AUTHENTICATION_API
      # stays off). Caddy passes no identity with a request that carries a
      # token, so git over HTTPS with a token works as before.
      FORGEJO__security__REVERSE_PROXY_AUTHENTICATION_USER = "Remote-User";
      FORGEJO__service__ENABLE_REVERSE_PROXY_AUTO_REGISTRATION = "false";
      # These only decide whose X-Forwarded-For Forgejo believes for the
      # client address in its logs. Forgejo counts a unix socket client as
      # 127.0.0.1, and only Caddy reaches the socket.
      FORGEJO__security__REVERSE_PROXY_TRUSTED_PROXIES = "127.0.0.1/32";
      FORGEJO__security__REVERSE_PROXY_LIMIT = "1";
    } // lib.optionalAttrs oidc.enable {
      # Registration stays closed for the sign up form; sign in through the
      # provider creates accounts regardless. tsidp's email claim is the
      # tailnet login, so new users are named after its local part; Pocket
      # ID's preferred_username is the account's username, unique there. An
      # existing account with that name or email is linked only after its
      # password is given: users can add email addresses to their Forgejo
      # accounts, and change their own username and email in Pocket ID.
      FORGEJO__oauth2_client__USERNAME =
        if oidc.provider == "pocket-id" then "preferred_username" else "email";
      FORGEJO__oauth2_client__ACCOUNT_LINKING = "login";
    } // cfg.extraEnvironment;
  };

  # The tailnet port bind only succeeds once tailscale has assigned the
  # tailnet IP, so order after tailscaled and retry until it exists, as the
  # reverse proxy does.
  systemd.services.podman-forgejo = {
    after = [ "tailscaled.service" ];
    wants = [ "tailscaled.service" ];
    startLimitIntervalSec = 0;
    serviceConfig = {
      Restart = lib.mkForce "on-failure";
      RestartSec = lib.mkForce 5;
    };
  };

  # Runs on every boot and does nothing once an admin exists. The password
  # is only in the journal line the script prints. Wants rather than
  # requires: podman-forgejo may fail its first starts until the tailnet
  # address exists, and the script waits for Forgejo to answer instead.
  systemd.services.forgejo-admin = lib.mkIf (admin.name != null) {
    description = "Create Forgejo's first admin";
    after = [ "podman-forgejo.service" ];
    wants = [ "podman-forgejo.service" ];
    wantedBy = [ "multi-user.target" ];
    path = [ config.virtualisation.podman.package ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      ExecStart = utils.escapeSystemdExecArgs ([
        "${adminScript}/bin/forgejo-admin"
        admin.name
        admin.email
        "https://git.${domain}/user/login"
      ] ++ lib.optional proxyAuth httpSocket);
    };
  };

  # Runs on every boot and after a rebuild that changes it, and restarts
  # Forgejo when the source changed or Forgejo started before the provider
  # answered. Wants rather than requires, as forgejo-admin. After the unit
  # that writes the client's id and secret files: tsidp, when it runs on
  # this host, writes them before it starts; pocket-id-clients writes them
  # and restarts this unit when they change.
  systemd.services.forgejo-oidc = lib.mkIf oidc.enable {
    description = "Set up Forgejo's OpenID Connect sign in";
    after = [ "podman-forgejo.service" "network-online.target" oidcProviderUnit ];
    wants = [ "podman-forgejo.service" "network-online.target" ];
    wantedBy = [ "multi-user.target" ];
    path = [ config.virtualisation.podman.package config.systemd.package ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      StateDirectory = "forgejo-oidc";
      StateDirectoryMode = "0700";
      ExecStart = utils.escapeSystemdExecArgs ([
        "${oidcScript}/bin/forgejo-oidc"
        oidcSource
        oidc.issuer
        oidc.clientIdFile
        oidc.clientSecretFile
        "/var/lib/forgejo-oidc/applied"
      ] ++ oidcFormerSources);
    };
  };
}
