# Example Caddyfile for the reverse-proxy module. __DOMAIN__ is replaced with
# homelab.domain at build time. Certificates come from the acme module and are
# mounted at /certs. Upstream container names resolve over the podman network;
# 192.0.2.10 stands in for a LAN device outside podman (RFC 5737 range).
{
	auto_https off
}

(site_tls) {
	tls /certs/fullchain.pem /certs/key.pem
}

# Passes the tailnet user to the upstream as Remote-User (the login name, e.g.
# alice@github). Needs homelab.reverseProxy.tailscaleIdentity.enable, which
# provides the WhoIs socket; the host refuses to build without it.
# Import it at the top of a site block, before reverse_proxy (inside each
# handle block, if the site has them). The route keeps the steps in order:
#  - Remote-User and Tailscale-* headers from the client are always deleted.
#  - A request with an Authorization header skips the lookup and reaches the
#    service without an identity, so tokens keep working from tagged nodes.
#  - Otherwise WhoIs on the client address sets Remote-User. A tagged node
#    (403) or a non-tailnet address (401) gets no identity and the request
#    goes on, so the service shows its own sign-in.
(tailnet_identity) {
	route {
		request_header -Remote-User
		request_header -Tailscale-*
		@tailnet_identity_no_token not header Authorization *
		forward_auth @tailnet_identity_no_token unix//run/tailnet-identity/whois.sock {
			uri /auth
			header_up Remote-Addr {remote_host}
			header_up Remote-Port {remote_port}
			copy_headers Tailscale-User>Remote-User
			@tailnet_identity_no_user status 401 403
			handle_response @tailnet_identity_no_user
		}
	}
}

start.__DOMAIN__:443 {
	import site_tls
	reverse_proxy homepage:3000
}

vault.__DOMAIN__:443 {
	import site_tls
	reverse_proxy vaultwarden:8080
}

registry.__DOMAIN__:443 {
	import site_tls
	reverse_proxy registry:5000
}

# Forgejo's web UI and API. Git over SSH bypasses Caddy: the forgejo module
# publishes it on the tailnet address, port 2222.
# forgejo_identity (generated from homelab.forgejo.proxyAuth.users, and
# including tailnet_identity) signs the tailnet user in. With
# homelab.forgejo.proxyAuth on, Forgejo listens only on this socket; without
# it, drop the import and use reverse_proxy forgejo:3000.
git.__DOMAIN__:443 {
	import site_tls
	import forgejo_identity
	reverse_proxy unix//run/forgejo-http/http.sock
}

# grafana_identity (generated from homelab.observability.grafanaProxyAuth,
# and including tailnet_identity) signs the listed tailnet users in as
# admins. Without the option, drop the import: Grafana is then open to
# anyone who reaches it, as Admin.
status.__DOMAIN__:443 {
	import site_tls
	import grafana_identity
	reverse_proxy grafana:3000
}

metrics.__DOMAIN__:443 {
	import site_tls
	reverse_proxy prometheus:9090
}

logs.__DOMAIN__:443 {
	import site_tls
	reverse_proxy loki:3100
}

# Echoes the identity Caddy passes on, to test tailnet_identity by hand.
whoami.__DOMAIN__:443 {
	import site_tls
	import tailnet_identity
	respond "Remote-User: {header.Remote-User}"
}

# A device on the LAN, outside podman, by IP.
nas.__DOMAIN__:443 {
	import site_tls
	reverse_proxy 192.0.2.10:5000
}

# Everything else gets the static 404 page.
*.__DOMAIN__:443, __DOMAIN__:443 {
	import site_tls
	rewrite * /404.html
	root * /var/www
	file_server
}
